{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc:current-bootstrap:0.2",
  "title": "Current Bootstrap State v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "product_or_workstream",
    "observed_code_ref",
    "observed_at",
    "role",
    "kernel_version",
    "requirements_ref",
    "product_state_ref",
    "active_campaign_ref",
    "active_checkpoint_or_terminal_ref",
    "current_gate",
    "strongest_evidence_refs",
    "next_legal_boundary",
    "forbidden_actions",
    "currentness"
  ],
  "properties": {
    "schema_version": {"const": "starter-bootstrap-0.2"},
    "status": {"enum": ["UNTRUSTED_CONTEXT", "READY", "HOLD"]},
    "product_or_workstream": {"type": "string", "minLength": 1},
    "observed_code_ref": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "role": {"type": "string", "minLength": 1},
    "kernel_version": {"type": "string", "minLength": 1},
    "requirements_ref": {"type": "string", "minLength": 1},
    "product_state_ref": {"type": "string", "minLength": 1},
    "active_campaign_ref": {"type": ["string", "null"]},
    "active_checkpoint_or_terminal_ref": {"type": ["string", "null"]},
    "current_gate": {"type": "string", "minLength": 1},
    "strongest_evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "next_legal_boundary": {"type": "string", "minLength": 1},
    "forbidden_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "currentness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "verified_at", "source_refs", "unresolved"],
      "properties": {
        "verified": {"type": "boolean"},
        "verified_at": {"type": ["string", "null"], "format": "date-time"},
        "source_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "unresolved": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"verified": {"const": true}}},
          "then": {"properties": {"verified_at": {"type": "string", "format": "date-time"}}}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "READY"}}},
      "then": {
        "properties": {
          "currentness": {
            "properties": {
              "verified": {"const": true},
              "unresolved": {"maxItems": 0}
            }
          }
        }
      }
    }
  ]
}
