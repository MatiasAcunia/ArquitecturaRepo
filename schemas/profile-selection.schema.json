{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc:profile-selection:0.1",
  "title": "Agentic SDLC Profile Selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "starter_version",
    "profile",
    "description",
    "selected_protocols",
    "recommended_current_contracts"
  ],
  "properties": {
    "schema_version": {"const": "starter-profile-selection-0.1"},
    "starter_version": {"type": "string", "minLength": 1},
    "profile": {
      "enum": [
        "SMALL",
        "STATEFUL",
        "ARTIFACT_HEAVY",
        "MULTI_WORKSTREAM",
        "MULTI_PRODUCT",
        "HIGH_CONSEQUENCE"
      ]
    },
    "description": {"type": "string", "minLength": 1},
    "selected_protocols": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "recommended_current_contracts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
