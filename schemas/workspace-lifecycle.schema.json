{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc:workspace-lifecycle:0.1",
  "title": "Agentic SDLC Workspace Lifecycle Marker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "lifecycle_class",
    "owner",
    "created_at",
    "expires_at",
    "lease_until",
    "safe_delete",
    "source_repo",
    "source_ref",
    "reason"
  ],
  "properties": {
    "schema_version": {"const": "workspace-lifecycle-0.1"},
    "workspace_id": {"type": "string", "minLength": 1},
    "lifecycle_class": {
      "enum": [
        "EPHEMERAL_RECONSTRUCTIBLE",
        "CACHE_RECONSTRUCTIBLE",
        "SHORT_TERM_EVIDENCE",
        "QUARANTINE_UNRESOLVED",
        "PROTECTED_CURRENT_OR_EVIDENCE"
      ]
    },
    "owner": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "lease_until": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "safe_delete": {"type": "boolean"},
    "source_repo": {"type": ["string", "null"]},
    "source_ref": {"type": ["string", "null"]},
    "reason": {"type": "string"}
  }
}
