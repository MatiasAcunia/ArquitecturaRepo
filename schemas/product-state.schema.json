{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc:product-state:0.1",
  "title": "Agentic SDLC Product State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_or_workstream",
    "state_version",
    "status",
    "updated_at",
    "current_code_ref",
    "product_objective",
    "currentness_set",
    "capabilities",
    "current_gate",
    "strongest_evidence_refs",
    "next_legal_boundary",
    "forbidden_actions"
  ],
  "properties": {
    "schema_version": {"const": "product-state-0.1"},
    "product_or_workstream": {"type": "string", "minLength": 1},
    "state_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["CURRENT", "HOLD", "RECONCILIATION_REQUIRED"]},
    "updated_at": {"type": "string", "format": "date-time"},
    "current_code_ref": {"type": "string", "minLength": 1},
    "product_objective": {"type": "string", "minLength": 1},
    "requirement_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "open_product_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "currentness_set": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "physical_state", "gate", "dependencies", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "physical_state": {"type": "string", "minLength": 1},
          "gate": {"type": "string", "minLength": 1},
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "active_campaign": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["campaign_id", "charter_ref", "checkpoint_or_terminal_ref"],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 1},
        "charter_ref": {"type": "string", "minLength": 1},
        "checkpoint_or_terminal_ref": {"type": ["string", "null"]}
      }
    },
    "current_gate": {"type": "string", "minLength": 1},
    "strongest_evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "blockers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "next_legal_boundary": {"type": "string", "minLength": 1},
    "forbidden_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
