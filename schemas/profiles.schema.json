{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc:profiles:0.1",
  "title": "Agentic SDLC Starter Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": {"const": "starter-profiles-0.1"},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "optional_protocols",
          "recommended_current_contracts"
        ],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "optional_protocols": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "recommended_current_contracts": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
