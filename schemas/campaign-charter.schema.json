{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc:campaign-charter:0.1",
  "title": "Engineering Campaign Charter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "product_or_workstream",
    "capability",
    "baseline_ref",
    "goal",
    "architecture_envelope",
    "resource_envelope",
    "verification_gates",
    "charter_invalidation_events",
    "done_when"
  ],
  "properties": {
    "schema_version": {"const": "campaign-charter-0.1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "product_or_workstream": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "baseline_ref": {"type": "string", "minLength": 1},
    "critical_path_relevance": {"type": "string"},
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_capability", "required_capability"],
      "properties": {
        "current_capability": {"type": "string", "minLength": 1},
        "required_capability": {"type": "string", "minLength": 1}
      }
    },
    "architecture_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owners", "fixed_interfaces", "protected_boundaries"],
      "properties": {
        "owners": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fixed_interfaces": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "allowed_interface_evolution": {"type": "array", "items": {"type": "string"}},
        "state_semantics": {"type": "array", "items": {"type": "string"}},
        "protected_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "resource_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_write_surfaces", "protected_surfaces", "external_authority_gates"],
      "properties": {
        "allowed_write_surfaces": {"type": "array", "items": {"type": "string"}},
        "protected_surfaces": {"type": "array", "items": {"type": "string"}},
        "shared_resources": {"type": "array", "items": {"type": "string"}},
        "external_authority_gates": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "STATIC_STRUCTURAL",
          "UNIT_PROPERTY",
          "INTEGRATION",
          "DB_CURRENTNESS_LINEAGE_RECOVERY",
          "RUNTIME_PHYSICAL",
          "SEMANTIC_GENERALIZATION",
          "SECURITY_RIGHTS_PRIVACY",
          "PERCEPTUAL_HUMAN",
          "RELEASE_PUBLICATION",
          "LIVE_MARKET"
        ]
      },
      "uniqueItems": true
    },
    "independent_review_required": {"type": "boolean", "default": true},
    "charter_invalidation_events": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "done_when": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
