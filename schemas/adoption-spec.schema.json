{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc:adoption-spec:0.1",
  "title": "Agentic SDLC Adoption Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_or_workstream",
    "current_code_ref",
    "product_objective",
    "role",
    "current_gate",
    "verified_at",
    "requirements",
    "open_product_questions",
    "capabilities",
    "evidence_refs",
    "currentness_refs",
    "custom_owners",
    "architecture_invariants",
    "state_semantics",
    "verification_gates",
    "external_authority",
    "next_legal_boundary",
    "forbidden_actions"
  ],
  "properties": {
    "schema_version": {"const": "adoption-spec-0.1"},
    "product_or_workstream": {"type": "string", "minLength": 1},
    "current_code_ref": {"type": "string", "minLength": 1},
    "product_objective": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "current_gate": {"type": "string", "minLength": 1},
    "verified_at": {"type": "string", "format": "date-time"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "strength", "decision"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "strength": {
            "enum": [
              "HARD_REQUIREMENT",
              "EXPLICIT_DECISION",
              "QUALITY_BAR",
              "STRONG_PREFERENCE",
              "DIRECTION"
            ]
          },
          "decision": {"type": "string", "minLength": 1}
        }
      }
    },
    "open_product_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "physical_state",
          "gate",
          "dependencies",
          "evidence_refs"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "physical_state": {"type": "string", "minLength": 1},
          "gate": {"type": "string", "minLength": 1},
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "currentness_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "custom_owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concern_id",
          "surface_ref",
          "surface_type",
          "required_in_currentness_set"
        ],
        "properties": {
          "concern_id": {"type": "string", "minLength": 1},
          "surface_ref": {"type": "string", "minLength": 1},
          "surface_type": {"enum": ["FILE", "DIRECTORY", "EXTERNAL"]},
          "required_in_currentness_set": {"type": "boolean"}
        }
      }
    },
    "architecture_invariants": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "state_semantics": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "verification_gates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "external_authority": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "next_legal_boundary": {"type": "string", "minLength": 1},
    "forbidden_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
