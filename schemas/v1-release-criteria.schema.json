{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc:v1-release-criteria:0.1",
  "title": "Agentic SDLC v1 Release Criteria",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "policy", "gates"],
  "properties": {
    "schema_version": {"const": "v1-release-criteria-0.1"},
    "release": {"type": "string", "minLength": 1},
    "policy": {"type": "string", "minLength": 1},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "command"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
