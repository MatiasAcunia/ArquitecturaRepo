{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-sdlc:starter-manifest:0.1",
  "title": "Agentic SDLC Starter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "starter",
    "version",
    "status",
    "content_policy",
    "core_role_model",
    "profiles",
    "machine_readable_contracts",
    "core_protocols",
    "optional_protocols",
    "claim_boundary",
    "fresh_context_required",
    "one_concern_one_owner",
    "worker_pass_is_acceptance"
  ],
  "properties": {
    "starter": {
      "const": "agentic-sdlc-starter"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "PUBLIC_STARTER_PREVIEW"
    },
    "content_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure_only",
        "project_specific_source_data_allowed",
        "real_source_names_allowed",
        "real_source_repositories_allowed",
        "real_source_branches_allowed",
        "real_source_identifiers_allowed",
        "real_source_provider_economics_allowed"
      ],
      "properties": {
        "structure_only": {
          "const": true
        },
        "project_specific_source_data_allowed": {
          "const": false
        },
        "real_source_names_allowed": {
          "const": false
        },
        "real_source_repositories_allowed": {
          "const": false
        },
        "real_source_branches_allowed": {
          "const": false
        },
        "real_source_identifiers_allowed": {
          "const": false
        },
        "real_source_provider_economics_allowed": {
          "const": false
        }
      }
    },
    "core_role_model": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "machine_readable_contracts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "core_protocols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "optional_protocols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "fresh_context_required": {
      "const": true
    },
    "one_concern_one_owner": {
      "const": true
    },
    "worker_pass_is_acceptance": {
      "const": false
    },
    "latest_schema_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
